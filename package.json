{
  "name": "grid-construction-cap",
  "version": "1.0.0",
  "description": "CAP app for power grid construction projects with a (mocked) S/4HANA stock connection",
  "scripts": {
    "start": "cds-serve",
    "s4mock": "node s4-mock/server.js",
    "dev": "node s4-mock/server.js & cds-serve",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@cap-js/sqlite": "^2",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^9",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "jest": "^29"
  },
  "cds": {
    "requires": {
      "API_MATERIAL_STOCK": {
        "kind": "odata",
        "model": "srv/external/API_MATERIAL_STOCK",
        "credentials": {
          "url": "http://localhost:4010/s4"
        }
      }
    }
  },
  "jest": {
    "testTimeout": 30000
  }
}
